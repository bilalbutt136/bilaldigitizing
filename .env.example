# Supabase API Configuration (public values — safe to commit)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only service role key (secret — NEVER commit a real value here)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only master admin email (seed the public.admins table with it)
MASTER_ADMIN_EMAIL=owner@example.com

# Production Custom Domain Configuration (Change to your live domain in production)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://yourdomain.com/api
