# ==============================================================================
# B Digitizing Studio - Environment Configuration Template (.env.example)
# Duplicate this file to .env.local for local testing and configure variables in Vercel.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database, Realtime & Auth)
# ------------------------------------------------------------------------------
# Public Supabase Project URL & Anon/Public API Key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret Server-Only Service Role Key (Used for admin queries, webhooks & migrations)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Direct PostgreSQL Connection String. Strongly recommended for `npm run migrate`
# so the runner can hold a distributed PostgreSQL advisory lock across deploys.
# Format: postgresql://postgres:[password]@db.your-project-ref.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Hardened migration runner controls (milliseconds).
MIGRATION_LOCK_WAIT_MS=15000
MIGRATION_COMMAND_TIMEOUT_MS=180000

# ------------------------------------------------------------------------------
# 2. Master Administrator Authorization
# ------------------------------------------------------------------------------
# Primary master admin email for automated verification and admin routing
MASTER_ADMIN_EMAIL=admin@yourdomain.com

# ------------------------------------------------------------------------------
# 3.# Production Domain & Public URL
# ------------------------------------------------------------------------------
# Live canonical site domain (Vercel deployment or custom production domain)
NEXT_PUBLIC_SITE_URL=https://bdigitizing.com
NEXT_PUBLIC_API_URL=https://bdigitizing.com/api

# Public business contact number displayed in metadata and schema.org
NEXT_PUBLIC_BUSINESS_PHONE=+1 (347) 915-4498

# ------------------------------------------------------------------------------
# 4. Third-Party Authentication (OAuth)
# ------------------------------------------------------------------------------
# Google OAuth Client ID for Google One-Tap & Sign-In button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Apple Sign-In Client Service ID (Optional)
NEXT_PUBLIC_APPLE_CLIENT_ID=com.yourdomain.service

# ------------------------------------------------------------------------------
# 5. Payment Gateways (Stripe & BoltPayouts)
# ------------------------------------------------------------------------------
# Stripe Secret Key and Webhook Signing Secret (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# BoltPayouts API Configuration (Alternative & Crypto/CashApp payments)
BOLTPAYOUTS_API_KEY=bolt_live_...
BOLTPAYOUTS_WEBHOOK_SECRET=bolt_sec_...

# ------------------------------------------------------------------------------
# 6. Artificial Intelligence (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini AI API Key for Auto-Pilot support and smart message refinement
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 7. Transactional Email (Resend)
# ------------------------------------------------------------------------------
# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=BDigitizing Support <support@bdigitizing.com>

# Webhook secret to secure /api/send-notification from unauthorized calls
NOTIFICATION_WEBHOOK_SECRET=your-long-random-webhook-secret

# ------------------------------------------------------------------------------
# 8. Media Storage (Cloudinary - Optional fallback to Supabase Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ------------------------------------------------------------------------------
# 9. Web Push (VAPID)
# ------------------------------------------------------------------------------
# Generate once with: npx web-push generate-vapid-keys
# Keep VAPID_PRIVATE_KEY server-only. Do not commit real keys.
VAPID_PUBLIC_KEY=your-vapid-public-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@yourdomain.com

# ------------------------------------------------------------------------------
# 10. Analytics & Tracking (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=

# Structured API observability: requests slower than this threshold emit a warning log.
OBSERVABILITY_SLOW_REQUEST_MS=1500
